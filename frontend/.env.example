# MQTT-over-WebSockets broker connection for the networked restaurant engine
# (frontend/src/lib/restaurant/mqtt-engine.svelte.ts). Both values are safe
# to be public (see backend/README.md's Security section) - they're baked
# into the browser bundle by design, not secrets.

# The Mosquitto WS listener from backend/docker-compose.yml.
PUBLIC_MQTT_URL=ws://localhost:9001

# Must match whatever password backend/mosquitto/generate_passwd.sh was run
# with for the "customer" account (see backend/mosquitto/acl.conf).
PUBLIC_MQTT_CUSTOMER_PASSWORD=changeme

# 'mqtt' (default) uses the real backend; 'local' falls back to the fully
# client-side simulation in local-engine.svelte.ts (no broker needed).
PUBLIC_ENGINE_MODE=mqtt
